{
  "name": "trade-cost-engine",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "国际贸易成本与贸易术语方案分析系统",
  "scripts": {
    "check:fee-source-compatibility": "node tools/check-fee-source-compatibility.mjs",
    "check:fee-source-compatibility:browser": "node tools/check-fee-source-compatibility-browser.mjs",
    "check:fee-source-adapter:browser": "node tools/check-fee-source-adapter-browser.mjs",
    "check:fee-source-views": "node tools/check-fee-source-views.mjs",
    "check:fee-text-sharing": "node tools/check-fee-text-sharing.mjs",
    "benchmark:fees": "node tools/benchmark-fee-workbench.mjs",
    "benchmark:fees:browser": "node tools/benchmark-fee-browser.mjs",
    "check:container-review-design": "node tools/check-container-cost-review-design.mjs",
    "check:funding-period-design": "node tools/check-funding-period-design.mjs",
    "build:catalog": "node tools/build-project-catalog.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build && node tools/build-single.mjs",
    "preview": "vite preview",
    "serve": "node tools/serve.mjs",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "node tools/audit.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "decimal.js": "^10.6.0",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "ajv": "8.20.0",
    "typescript": "^7.0.2",
    "vite": "7.3.7",
    "vitest": "^5.0.0"
  }
}
