{
  "name": "trade-cost-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "国际贸易成本与贸易术语方案分析系统",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build && node tools/build-single.mjs",
    "preview": "vite preview",
    "serve": "node tools/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "node tools/audit.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
