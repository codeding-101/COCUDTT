{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cocudtt:internal-fee-application-envelope:1.0",
  "title": "COCUDTT internal fee envelope 1.0",
  "description": "Independent read-only file. Schema checks outer shape only; runtime checks nested duplicate keys, UTF-8/UTF-16, fingerprints, archive closure and roles, complete source reviews, historical project changes and identity. No financial writes or real-order certification.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "INTERNAL_FEE_APPLICATION_ENVELOPE"
    },
    "version": {
      "const": "1.0"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "\\S",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "business_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "\\S",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "history_origin": {
      "enum": [
        "NEW_DECLARED",
        "UNKNOWN_IMPORTED"
      ]
    },
    "current_sources": {
      "type": "object",
      "properties": {
        "project_json": {
          "type": "string"
        },
        "bill_json": {
          "type": "string"
        },
        "pair_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "attachment_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision_json": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project_json",
        "bill_json",
        "pair_json",
        "attachment_json",
        "precision_json"
      ],
      "additionalProperties": false
    },
    "ledger_json": {
      "type": "string"
    },
    "archives": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raw_json": {
            "type": "string"
          }
        },
        "required": [
          "sha256",
          "raw_json"
        ],
        "additionalProperties": false
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "version",
    "envelope_id",
    "business_id",
    "revision",
    "history_origin",
    "current_sources",
    "ledger_json",
    "archives",
    "content_sha256"
  ],
  "additionalProperties": false
}
